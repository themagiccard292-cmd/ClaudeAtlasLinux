{
  "name": "claude-os-agent",
  "productName": "Claude OS Agent",
  "version": "0.1.0",
  "description": "Autonomous Linux desktop agent with a Claude-style UI, powered by your Claude Pro subscription (no API key).",
  "author": {
    "name": "Claude OS Agent contributors",
    "email": "claude-os-agent@users.noreply.github.com"
  },
  "homepage": "https://github.com/themagiccard292-cmd/ClaudeAtlasLinux",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && ATLAS_DEV=1 electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-assets.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "icons": "python3 scripts/make-icons.py",
    "backend:build": "bash scripts/build-backend.sh",
    "pack": "npm run build && electron-builder --linux --dir",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.claudeosagent.app",
    "productName": "Claude OS Agent",
    "executableName": "claude-os-agent",
    "copyright": "MIT License",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/backend-linux",
        "to": "backend-linux"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icons",
      "maintainer": "Claude OS Agent contributors <claude-os-agent@users.noreply.github.com>",
      "synopsis": "Claude-powered autonomous Linux desktop agent",
      "description": "A Claude desktop-style app that drives your Linux desktop (X11 or Wayland) using your Claude Pro web session. No API key required.",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Claude-OS-Agent.${ext}"
    },
    "deb": {
      "artifactName": "claude-os-agent.${ext}",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libportaudio2",
        "xdotool",
        "x11-xserver-utils",
        "python3",
        "python3-gi",
        "gir1.2-atspi-2.0",
        "python3-pyatspi"
      ],
      "recommends": [
        "ydotool",
        "wtype",
        "grim",
        "espeak-ng",
        "pipewire-pulse | pulseaudio"
      ]
    }
  },
  "desktopName": "claude-os-agent.desktop"
}
